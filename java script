function desenharCena() {
  // fundo
  ctx.fillStyle = "skyblue";
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // mãos
  ctx.fillStyle = "tan";
  ctx.fillRect(350, 550, 40, 40);
  ctx.fillRect(410, 550, 40, 40);

  // linhas
  ctx.strokeStyle = "black";
  ctx.beginPath();
  ctx.moveTo(370, 550);
  ctx.lineTo(pipa.x, pipa.y);
  ctx.moveTo(430, 550);
  ctx.lineTo(pipa.x, pipa.y);
  ctx.stroke();

  // pipa
  ctx.fillStyle = pipaAtual.cor;
  ctx.beginPath();
  ctx.moveTo(pipa.x, pipa.y);
  ctx.lineTo(pipa.x - pipa.size, pipa.y + pipa.size);
  ctx.lineTo(pipa.x + pipa.size, pipa.y + pipa.size);
  ctx.closePath();
  ctx.fill();
}
